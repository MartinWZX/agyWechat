# WeChat Webhook Verification Token
WECHAT_TOKEN=your_wechat_webhook_token_here

# WeChat Push Message API Endpoint & Secret
WECHAT_PUSH_URL=https://api.weixin.qq.com/cgi-bin/message/custom/send
WECHAT_BOT_SECRET=your_wechat_bot_secret_here

# Allowed WeChat User OpenIDs (comma-separated or JSON list)
ALLOWED_USERS=["user_test_openid"]

# Workspace root sandbox path (defaults to current working directory)
WORKSPACE_ROOT=/path/to/your/workspace

# Path to agy executable (defaults to agy in PATH, or /usr/local/bin/agy)
AGY_BINARY=agy

# Default arguments for agy
AGY_DEFAULT_ARGS=[]

# PTY terminal dimensions
PTY_COLS=120
PTY_ROWS=40

# Cleaner and buffer settings
DEBOUNCE_SECONDS=1.5
MAX_CHUNK_CHARS=1500
WECHAT_MAX_MSG_LEN=2000

# Server settings
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
