# WeChat Webhook Verification Token
WECHAT_TOKEN=your_wechat_webhook_token_here
WEBHOOK_REQUIRE_SIGNATURE=false

# WeChat Push Message API Endpoint & Secret
WECHAT_PUSH_URL=https://api.weixin.qq.com/cgi-bin/message/custom/send
WECHAT_BOT_SECRET=your_wechat_bot_secret_here

# Allowed & Admin WeChat User OpenIDs (comma-separated or JSON list)
ALLOWED_USERS=["user_test_openid"]
ADMIN_USERS=["admin_user"]

# Workspace root & SQLite DB path
WORKSPACE_ROOT=/path/to/your/workspace
DB_PATH=memory/agent_core.db

# CLI Engine binary overrides (defaults to names in PATH)
AGY_BINARY=agy
PI_BINARY=pi
CLAUDE_BINARY=claude
OMP_BINARY=omp

# Outbound WeChat message split threshold
WECHAT_MAX_MSG_LEN=2000

# Server settings
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# WeChat iLink Bot (Personal WeChat direct login via ./scripts/login_wechat.py)
WECHAT_CHANNEL=webhook
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
